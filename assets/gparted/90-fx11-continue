#!/bin/sh
set -eu

# FX11 boot-time live-config hook. It does not modify the GParted application;
# it adds a handoff action to the surrounding GParted Live desktop.

cat > /usr/local/sbin/fx11-continue-root <<'EOF'
#!/bin/sh
set -eu

LABEL=FX11BOOT
MARKER_REL=EFI/FX11/continue-installer
MOUNTPOINT=/run/fx11boot

DEVICE="$(blkid -L "$LABEL" 2>/dev/null || true)"
if [ -z "$DEVICE" ]; then
    echo "FX11BOOT EFI partition not found." >&2
    exit 2
fi

mkdir -p "$MOUNTPOINT"
if mountpoint -q "$MOUNTPOINT"; then
    umount "$MOUNTPOINT"
fi
mount -o rw "$DEVICE" "$MOUNTPOINT"
mkdir -p "$MOUNTPOINT/EFI/FX11"
: > "$MOUNTPOINT/$MARKER_REL"
sync
umount "$MOUNTPOINT"

systemctl reboot
EOF
chmod 0755 /usr/local/sbin/fx11-continue-root

cat > /usr/local/bin/fx11-continue <<'EOF'
#!/bin/sh
set -eu

QUESTION="Partitioning finished. Reboot and continue to FX11 Installer?"
ERROR="Could not prepare the FX11 Installer handoff. You can reboot and select FX11 Installer manually."

if command -v zenity >/dev/null 2>&1; then
    zenity --question --title="FX11" --text="$QUESTION" || exit 0
elif command -v xmessage >/dev/null 2>&1; then
    xmessage -center -buttons "Continue:0,Cancel:1" "$QUESTION" || exit 0
fi

if ! sudo -n /usr/local/sbin/fx11-continue-root; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="FX11" --text="$ERROR" || true
    elif command -v xmessage >/dev/null 2>&1; then
        xmessage -center "$ERROR" || true
    fi
    exit 1
fi
EOF
chmod 0755 /usr/local/bin/fx11-continue

# GParted Live uses Fluxbox plus idesk. A freedesktop .desktop file alone is
# therefore not sufficient to create a visible desktop icon.
make_idesk_launcher() {
    target_dir="$1"
    mkdir -p "$target_dir"
    cat > "$target_dir/fx11-installer.lnk" <<'EOF'
table Icon
  Caption: FX11 Installer
  Command: /usr/local/bin/fx11-continue
  Icon: /usr/share/pixmaps/exit.xpm
  Width: 48
  Height: 48
  X: 670
  Y: 20
  FontSize: 08
end
EOF
}

# GParted's startup scripts copy this template into the live user's home.
if [ -d /root/gparted-live/idesktop ]; then
    make_idesk_launcher /root/gparted-live/idesktop
fi

# Also cover the case where the live user's idesk directory already exists.
make_idesk_launcher /home/user/.idesktop
chown -R user:user /home/user/.idesktop 2>/dev/null || true

# Keep a freedesktop launcher for file-manager users as an additional fallback.
mkdir -p /usr/share/applications
cat > /usr/share/applications/fx11-installer.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Continue to FX11 Installer
Comment=Finish partitioning and continue the FX11 installation
Exec=/usr/local/bin/fx11-continue
Icon=system-reboot
Terminal=false
Categories=System;
EOF
chmod 0644 /usr/share/applications/fx11-installer.desktop

# Add the same action near the top of the Fluxbox root menu so the handoff is
# still reachable even if an idesk refresh behaves differently on a machine.
add_fluxbox_entry() {
    menu="$1"
    [ -f "$menu" ] || return 0
    grep -q "FX11 Installer" "$menu" && return 0
    sed -i '/^\[begin\]/a\  [exec] (FX11 Installer) {/usr/local/bin/fx11-continue}' "$menu"
}

add_fluxbox_entry /etc/X11/fluxbox/fluxbox.menu-user
add_fluxbox_entry /home/user/.fluxbox/menu

# Leave a small marker that can be checked from a terminal during debugging.
: > /run/fx11-gparted-handoff-ready
